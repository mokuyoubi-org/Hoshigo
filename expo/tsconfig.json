// tsconfig.json
// ts先生への指示書。
// パスで、@が意味するのはここのことだよーとか。
// ts先生の仕事は、型チェックと、tsxやtsの、jsへの翻訳。

{
  // ts先生がチェックするときに参考にする、基本の教科書。
  "extends": "expo/tsconfig.base",
  // ts先生への、細かい要求。
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react",
    "strict": true,
    "moduleSuffixes": [".native", ".web", ""],
    "paths": {
      "@/*": ["./*"]
    }
  },

  // ts先生が見る対象のファイル。
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
