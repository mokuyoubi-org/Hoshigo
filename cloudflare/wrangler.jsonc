// wrangler.jsonc
/* ⚠️⚠️⚠️このファイルをいじった後は、必ず
cd ~/Hoshigo/cloudflare
npx wrangler types
を実行すること⚠️⚠️⚠️
*/

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoshigo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoshigo-db",
      "database_id": "50856c52-a430-4bd4-be06-62ea1093cb39",
    },
    // 棋譜用DB
    {
      "binding": "RECORDS_DB",
      "database_name": "hoshigo-records-db",
      "database_id": "66d719e2-d1be-4d92-ac5d-af2e5c2000ac",
      "migrations_dir": "migrations-records",
    },
    // 詰碁用DB
    {
      "binding": "TSUMEGO_DB",
      "database_name": "hoshigo-tsumego",
      "database_id": "17616b56-d027-41cb-b0eb-214f5149a0a2",
      "migrations_dir": "migrations-tsumego",
    },
  ],
  // R2(棋譜・分析の倉庫)。手元の wrangler dev では、手元の仮のR2が使われる(本物には書かない)。
  "r2_buckets": [
    {
      "binding": "RECORDS",
      "bucket_name": "hoshigo-records",
    },
  ],
  // Durable Objects(リアルタイム対局の部屋)
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_ROOM",
        "class_name": "QueueRoom",
      },
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom",
      },
    ],
  },
  // 部屋のクラスの登録。SQLite版で作る(いまの標準)。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueueRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GameRoom"],
    },
  ],
}
